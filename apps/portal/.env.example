# Copie para .env.local. Sem nenhuma variável definida, o portal já resolve
# sozinho: localhost:<porta> em dev (ver packages/core/src/config/routes.ts),
# subdomínio sugerido em produção. Defina aqui só se precisar apontar pra
# staging ou pro domínio real definitivo antes do DNS estar pronto.

NEXT_PUBLIC_BIND_IMPORT_URL=
NEXT_PUBLIC_CF_DNS_IMPORT_URL=
NEXT_PUBLIC_CF_ACL_URL=
NEXT_PUBLIC_CF_PROXY_URL=

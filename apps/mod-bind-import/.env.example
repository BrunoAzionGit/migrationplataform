# Copie para .env.local (já está no .gitignore) e preencha com valores reais.
# NUNCA commitar este arquivo preenchido.

EDGE_SQL_URL=https://api.azion.com/v4/edge_sql/databases/<id>/query
EDGE_SQL_TOKEN=

OBJECT_STORAGE_BUCKET=storage-azion-migration-artifacts
OBJECT_STORAGE_ENDPOINT=https://s3.us-east-005.azionstorage.net
OBJECT_STORAGE_REGION=us-east-005
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Opcional — sem isso, o link "Portal" cai em localhost:3000 (dev) ou no
# subdomínio sugerido (prod). Ver packages/core/src/config/routes.ts.
NEXT_PUBLIC_PORTAL_URL=
